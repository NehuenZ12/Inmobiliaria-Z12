@model IEnumerable<mvc.Models.Inquilino>

<h1>Inquilinos</h1>

@if (TempData["Ok"] != null)
{
  <div class="alert alert-success">@TempData["Ok"]</div>
}

@if (TempData["Error"] != null)
{
  <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Boton para crear un nuevo inquilino -->
<a asp-action="Create" class="btn btn-primary mb-3">
  +
</a>

<table class="table">
  <thead>
    <tr>
      <th>Código</th>
      <th>Nombre</th>
      <th>Apellido</th>
      <th>DNI</th>
      <th>Teléfono</th>
      <th>Email</th>
      <th>Acciones</th>
    </tr>
  </thead>

  <tbody>
    @foreach (var inquilino in Model)
    {
      <tr>
        <td>@inquilino.Id</td>
        <td>@inquilino.Nombre</td>
        <td>@inquilino.Apellido</td>
        <td>@inquilino.Dni</td>
        <td>@inquilino.Telefono</td>
        <td>@inquilino.Email</td>

        <td>
          <!-- Boton Editar -->
          <a asp-action="Edit" asp-route-id="@inquilino.Id" class="btn btn-primary">
            Editar
          </a>

          <!-- Boton Eliminar -->
          <form asp-action="Delete" asp-route-id="@inquilino.Id" method="post" style="display:inline">

            <button type="submit" class="btn btn-danger"
                    onclick="return confirm('¿Está seguro de eliminar este inquilino?')">
              Eliminar
            </button>

          </form>
        </td>
      </tr>
    }
  </tbody>
</table>
@{
  int paginaActual = ViewBag.PaginaActual;
  int totalPaginas = ViewBag.TotalPaginas;

  int ventana = 2;
  int desde = Math.Max(1, paginaActual - ventana);
  int hasta = Math.Min(totalPaginas, paginaActual + ventana);
}

<nav class="mt-3">
  <ul class="pagination">
    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
      <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)">Anterior</a>
    </li>

    @if (desde > 1)
    {
      <li class="page-item">
        <a class="page-link" asp-action="Index" asp-route-pagina="1">1</a>
      </li>
      if (desde > 2)
      {
        <li class="page-item disabled"><span class="page-link">...</span></li>
      }
    }

    @for (int i = desde; i <= hasta; i++)
    {
      <li class="page-item @(i == paginaActual ? "active" : "")">
        <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
      </li>
    }

    @if (hasta < totalPaginas)
    {
      if (hasta < totalPaginas - 1)
      {
        <li class="page-item disabled"><span class="page-link">...</span></li>
      }
      <li class="page-item">
        <a class="page-link" asp-action="Index" asp-route-pagina="@totalPaginas">@totalPaginas</a>
      </li>
    }

    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
      <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
    </li>
  </ul>
</nav>