@model IEnumerable<mvc.Models.Reserva>

<h1>Reservas</h1>

<div class="mb-3 d-flex gap-2">
  <a asp-action="Create" class="btn btn-primary">+</a>
  <a asp-action="Vigentes" class="btn btn-outline-success">Ver vigentes</a>
  <a asp-action="TerminanEn" class="btn btn-outline-warning">Terminan pronto</a>
  <a asp-action="InmueblesLibres" class="btn btn-outline-info">Buscar inmuebles libres</a>

</div>
</a>

<table class="table">
  <thead>
    <tr>
      <th>Codigo</th>
      <th>Inquilino</th>
      <th>Inmueble</th>
      <th>Desde</th>
      <th>Hasta</th>
      <th>Monto diario</th>
      <th>Importe total</th>
      <th>Estado</th>
      <th>Acciones</th>
    </tr>
  </thead>

  <tbody>
    @foreach (var reserva in Model)
    {
      <tr>
        <td>@reserva.Id</td>
        <td>@reserva.NombreInquilino</td>
        <td>@reserva.DireccionInmueble</td>
        <td>@reserva.FechaDesde.ToShortDateString()</td>
        <td>@reserva.FechaHasta.ToShortDateString()</td>
        <td>@reserva.MontoDiario</td>
        <td>@reserva.ImporteTotal</td>
        <td>
          @switch (reserva.EstadoMostrado)
          {
            case "Pendiente":
              <span class="badge bg-warning text-dark">Pendiente</span>
              break;
            case "Confirmada":
              <span class="badge bg-success">Vigente</span>
              break;
            case "Completada":
              <span class="badge bg-primary">Completada</span>
              break;
            case "Cancelada":
              <span class="badge bg-secondary">Cancelada</span>
              break;
          }
        </td>
        <td>
          <a asp-action="Detalles" asp-route-id="@reserva.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>

          @if (reserva.Estado == EstadoReserva.Pendiente)
          {

            <a asp-action="CheckIn" asp-route-id="@reserva.Id" class="btn btn-sm btn-outline-success">Check-in</a>
          }
          @if (reserva.Estado == EstadoReserva.Confirmada)
          {
            <a asp-action="Cancelar" asp-route-id="@reserva.Id" class="btn btn-sm btn-outline-danger">Cancelar</a>
            <a asp-action="Renovar" asp-route-id="@reserva.Id" class="btn btn-sm btn-outline-primary">Renovar</a>

          }
          @if (reserva.Estado != EstadoReserva.Cancelada)
          {
            <a asp-controller="Pagos" asp-action="Crear" asp-route-reservaId="@reserva.Id"
               class="btn btn-sm btn-outline-primary">Pago</a>
          }
        </td>
      </tr>
    }
  </tbody>

</table>
@{
  int paginaActual = ViewBag.PaginaActual;
  int totalPaginas = ViewBag.TotalPaginas;

  int ventana = 2;
  int desde = Math.Max(1, paginaActual - ventana);
  int hasta = Math.Min(totalPaginas, paginaActual + ventana);
}

<nav class="mt-3">
  <ul class="pagination">
    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
      <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)">Anterior</a>
    </li>

    @if (desde > 1)
    {
      <li class="page-item">
        <a class="page-link" asp-action="Index" asp-route-pagina="1">1</a>
      </li>
      if (desde > 2)
      {
        <li class="page-item disabled"><span class="page-link">...</span></li>
      }
    }

    @for (int i = desde; i <= hasta; i++)
    {
      <li class="page-item @(i == paginaActual ? "active" : "")">
        <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
      </li>
    }

    @if (hasta < totalPaginas)
    {
      if (hasta < totalPaginas - 1)
      {
        <li class="page-item disabled"><span class="page-link">...</span></li>
      }
      <li class="page-item">
        <a class="page-link" asp-action="Index" asp-route-pagina="@totalPaginas">@totalPaginas</a>
      </li>
    }

    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
      <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
    </li>
  </ul>
</nav>