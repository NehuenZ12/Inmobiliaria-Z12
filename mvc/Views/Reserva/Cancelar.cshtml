@model mvc.Models.Reserva

<h1>Cancelar reserva</h1>

<dl class="row">
  <dt class="col-sm-3">Fecha desde original</dt>
  <dd class="col-sm-9">@Model.FechaDesde.ToShortDateString()</dd>

  <dt class="col-sm-3">Fecha hasta original</dt>
  <dd class="col-sm-9">@Model.FechaHasta.ToShortDateString()</dd>

  <dt class="col-sm-3">Monto diario</dt>
  <dd class="col-sm-9">@Model.MontoDiario</dd>

  <dt class="col-sm-3">Porcentaje de multa</dt>
  <dd class="col-sm-9">@ViewBag.Porcentaje%</dd>

  <dt class="col-sm-3">Multa a cobrar</dt>
  <dd class="col-sm-9">@ViewBag.Multa</dd>
</dl>

<form asp-action="Cancelar" method="post">
  <input type="hidden" asp-for="Id" />
  <button type="submit" class="btn btn-danger">
    Confirmar cancelacion (multa: @ViewBag.Multa)
  </button>
  <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>