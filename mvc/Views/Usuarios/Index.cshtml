@model IEnumerable<mvc.Models.Usuario>

@{
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
    string q = ViewBag.Q ?? "";
    // Id del admin logueado, para no mostrarle Desactivar en su propia fila
    string idActual = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
}

<h1>Usuarios</h1>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@* GET para que la busqueda se resuelva en el servidor, no en JS *@
<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-6">
        <label class="form-label" for="q">Buscar</label>
        <input id="q" name="q" class="form-control" value="@q" placeholder="Nombre, apellido o email" />
    </div>
    <div class="col-md-6">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<a asp-action="Crear" class="btn btn-primary mb-3">Nuevo usuario</a>

@if (!Model.Any())
{
    <p>No hay usuarios para mostrar.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr class="@(usuario.Activo ? "" : "table-secondary")">
                    <td>@usuario.Id</td>
                    <td>@usuario.Nombre</td>
                    <td>@usuario.Apellido</td>
                    <td>@usuario.Email</td>
                    <td>@usuario.Rol</td>
                    <td>
                        @* El estado sale de Activo, no de un enum aparte *@
                        @if (usuario.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Perfil" asp-route-id="@usuario.Id" class="btn btn-primary btn-sm">Editar</a>

                        @* Baja logica: no se borra, se cambia Activo *@
                        @if (usuario.Id.ToString() != idActual)
                        {
                            @if (usuario.Activo)
                            {
                                <form asp-action="Desactivar" asp-route-id="@usuario.Id" method="post" style="display:inline">
                                    <button type="submit" class="btn btn-warning btn-sm" onclick="return confirm('Desactivar este usuario?')">Desactivar</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Activar" asp-route-id="@usuario.Id" method="post" style="display:inline">
                                    <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Activar este usuario?')">Activar</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@{
    // Ventana de numeros alrededor de la pagina actual (igual que en Pagos)
    int ventana = 2;
    int desde = Math.Max(1, paginaActual - ventana);
    int hasta = Math.Min(totalPaginas, paginaActual + ventana);
}

@if (totalPaginas > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @* asp-route-q para no perder la busqueda al cambiar de pagina *@
            <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-q="@q" asp-route-pagina="@(paginaActual - 1)">Anterior</a>
            </li>

            @if (desde > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-q="@q" asp-route-pagina="1">1</a>
                </li>
                if (desde > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @for (int i = desde; i <= hasta; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-q="@q" asp-route-pagina="@i">@i</a>
                </li>
            }

            @if (hasta < totalPaginas)
            {
                if (hasta < totalPaginas - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-q="@q" asp-route-pagina="@totalPaginas">@totalPaginas</a>
                </li>
            }

            <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-q="@q" asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
