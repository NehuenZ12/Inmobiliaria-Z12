@model mvc.Models.Reserva

<h1>Detalles de la reserva</h1>

<div class="mb-3">
    <strong>Código:</strong> @Model.Id
</div>

@if (User.IsInRole("Administrador"))
{
    <div class="card mt-4">
        <div class="card-header">
            Auditoría
        </div>
        <div class="card-body">
            <p class="mb-1"><strong>Creado por:</strong> @Model.NombreUsuarioCreador</p>
            @if (!string.IsNullOrEmpty(Model.NombreUsuarioTerminador))
            {
                <p class="mb-0"><strong>Terminado por:</strong> @Model.NombreUsuarioTerminador</p>
            }
        </div>
    </div>
}

<div class="mt-4">
    <a asp-controller="Propietario" asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
