@model IEnumerable<mvc.Models.Propietario>

<h1>Propietarios</h1>

<!-- Boton para crear un nuevo propietario -->
<a asp-action="Create" class="btn btn-primary mb-3">
    +
</a>

<table class="table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>DNI</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var propietario in Model)
        {
            <tr>
                <td>@propietario.Id</td>
                <td>@propietario.Nombre</td>
                <td>@propietario.Apellido</td>
                <td>@propietario.Dni</td>
                <td>@propietario.Telefono</td>
                <td>@propietario.Email</td>

                <td>
                    <!-- Boton Editar -->
                    <a asp-action="Edit"
                       asp-route-id="@propietario.Id"
                       class="btn btn-primary">
                        Editar
                    </a>

                    <!-- Boton Eliminar (solo Usuarios Administradores) -->
                    @if (User.IsInRole("Administrador"))
                    {
                        <form asp-action="Delete"
                              asp-route-id="@propietario.Id"
                              method="post"
                              style="display:inline">

                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('¿Está seguro de eliminar este propietario?')">
                                Eliminar
                            </button>

                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>