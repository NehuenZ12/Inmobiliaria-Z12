@model mvc.Models.Inmueble

<h1>Editar Inmueble</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">

  <input type="hidden" asp-for="Id" />

  <div class="mb-3">
    <label asp-for="Direccion" class="form-label">
      Dirección
    </label>

    <input asp-for="Direccion" class="form-control" />

    <span asp-validation-for="Direccion" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="Cupo" class="form-label">
      Cupo
    </label>

    <input asp-for="Cupo"
           type="number"
           class="form-control" />

    <span asp-validation-for="Cupo" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="TipoId" class="form-label">
      Tipo
    </label>

    <select asp-for="TipoId"
            asp-items="ViewBag.Tipos"
            class="form-select">

      <option value="">
        -- Seleccione un tipo --
      </option>

    </select>

    <span asp-validation-for="TipoId"
          class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="Latitud" class="form-label">
      Latitud
    </label>

    <input asp-for="Latitud"
           class="form-control" />

    <span asp-validation-for="Latitud"
          class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="Longitud" class="form-label">
      Longitud
    </label>

    <input asp-for="Longitud"
           class="form-control" />

    <span asp-validation-for="Longitud"
          class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="PrecioPorDia" class="form-label">
      Precio por día
    </label>

    <input asp-for="PrecioPorDia"
           type="number"
           step="0.01"
           class="form-control" />

    <span asp-validation-for="PrecioPorDia"
          class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="PorcentajeReserva" class="form-label">
      Porcentaje de reserva
    </label>

    <input asp-for="PorcentajeReserva"
           type="number"
           step="0.01"
           class="form-control" />

    <span asp-validation-for="PorcentajeReserva"
          class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="PropietarioId" class="form-label">
      Propietario
    </label>

    <select asp-for="PropietarioId"
            asp-items="ViewBag.Propietarios"
            class="form-select">

      <option value="">
        -- Seleccione un propietario --
      </option>

    </select>

    <span asp-validation-for="PropietarioId"
          class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="Disponible" class="form-label">
      Disponible
    </label>

    <input asp-for="Disponible"
           type="checkbox" />
  </div>

  <!-- IMAGENES ACTUALES -->

  <div class="mb-3">
    <label class="form-label">
      Imagenes actuales
    </label>

    @if (Model.Imagenes != null && Model.Imagenes.Any())
    {
        <div class="d-flex flex-wrap gap-3">

            @foreach (var imagen in Model.Imagenes)
            {
                <div>
                    <img src="@imagen.Url"
                         alt="Imagen del inmueble"
                         style="width: 150px; height: 100px; object-fit: cover; border-radius: 8px;" />

                    @if (imagen.EsPrincipal)
                    {
                        <div class="text-center text-success mt-1">
                            Principal
                        </div>
                    }
                </div>
            }

        </div>
    }
    else
    {
        <p class="text-muted">
            Este inmueble no tiene imágenes cargadas.
        </p>
    }
  </div>

  <!-- NUEVAS IMAGENES -->

  <div class="mb-3">
    <label class="form-label">
      Reemplazar imagenes
    </label>

    <input type="file"
           name="imagenes"
           class="form-control"
           multiple
           accept="image/*" />

    <small class="text-muted">
      Seleccione nuevas imagenes solamente si desea reemplazar las actuales.
      La primera imagen seleccionada sera la principal.
    </small>
  </div>

  <button type="submit"
          class="btn btn-primary">
    Guardar cambios
  </button>

  <a asp-action="Index"
     class="btn btn-secondary">
    Cancelar
  </a>

</form>