@model IEnumerable<mvc.Models.ViewModels.InmuebleReservaViewModel>

<h1>Inmuebles mas reservados</h1>

<p>
    Reservas realizadas en los ultimos 365 dias.
</p>

<table class="table">

    <thead>
        <tr>
            <th>Codigo</th>
            <th>Direccion</th>
            <th>Propietario</th>
            <th>Cantidad de reservas</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var inmueble in Model)
        {
            <tr>
                <td>@inmueble.Id</td>
                <td>@inmueble.Direccion</td>
                <td>@inmueble.Propietario</td>
                <td>@inmueble.CantidadReservas</td>
            </tr>
        }

    </tbody>

</table>


<!-- PAGINADO -->

@if (ViewBag.TotalPaginas > 1)
{
    <nav class="mt-3">

        <ul class="pagination">

            <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="MasReservados"
                   asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                    Anterior
                </a>
            </li>


            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                    <a class="page-link"
                       asp-action="MasReservados"
                       asp-route-pagina="@i">
                        @i
                    </a>

                </li>
            }


            <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-action="MasReservados"
                   asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                    Siguiente
                </a>
            </li>

        </ul>

    </nav>
}

<a asp-action="Index" class="btn btn-secondary">
    Volver
</a>