@model IEnumerable<mvc.Models.Inmueble>

<h1>Inmuebles sin reservas</h1>

<form asp-action="SinReservas" method="get" class="mb-4">

    <label class="form-label">
        Cantidad de dias
    </label>

    <div class="d-flex gap-2">

        <input type="number"
               name="dias"
               value="@ViewBag.Dias"
               min="1"
               class="form-control"
               style="max-width: 200px;" />

        <button type="submit"
                class="btn btn-primary">
            Buscar
        </button>

    </div>

</form>


<table class="table">

    <thead>
        <tr>
            <th>Codigo</th>
            <th>Direccion</th>
            <th>Propietario</th>
            <th>Disponible</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var inmueble in Model)
        {
            <tr>

                <td>@inmueble.Id</td>

                <td>@inmueble.Direccion</td>

                <td>
                    @inmueble.Propietario?.Nombre
                    @inmueble.Propietario?.Apellido
                </td>

                <td>
                    @(inmueble.Disponible ? "Sí" : "No")
                </td>

            </tr>
        }

    </tbody>

</table>


<!-- PAGINADO -->

@if (ViewBag.TotalPaginas > 1)
{
    <nav class="mt-3">

        <ul class="pagination">

            <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="SinReservas"
                   asp-route-dias="@ViewBag.Dias"
                   asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                    Anterior
                </a>
            </li>


            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                    <a class="page-link"
                       asp-action="SinReservas"
                       asp-route-dias="@ViewBag.Dias"
                       asp-route-pagina="@i">
                        @i
                    </a>

                </li>
            }


            <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-action="SinReservas"
                   asp-route-dias="@ViewBag.Dias"
                   asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                    Siguiente
                </a>
            </li>

        </ul>

    </nav>
}


<a asp-action="Index"
   class="btn btn-secondary">
    Volver
</a>