@model IEnumerable<mvc.Models.Inmueble>

<h1>Inmuebles sin reservas</h1>

<form asp-action="SinReservas" method="get" class="mb-4">

    <label class="form-label">
        Cantidad de días
    </label>

    <div class="d-flex gap-2">

        <input type="number"
               name="dias"
               value="@ViewBag.Dias"
               min="1"
               class="form-control"
               style="max-width: 200px;" />

        <button type="submit"
                class="btn btn-primary">
            Buscar
        </button>

    </div>

</form>

<table class="table">

    <thead>
        <tr>
            <th>Código</th>
            <th>Dirección</th>
            <th>Propietario</th>
            <th>Disponible</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var inmueble in Model)
        {
            <tr>

                <td>@inmueble.Id</td>

                <td>@inmueble.Direccion</td>

                <td>
                    @inmueble.Propietario?.Nombre
                    @inmueble.Propietario?.Apellido
                </td>

                <td>
                    @(inmueble.Disponible ? "Sí" : "No")
                </td>

            </tr>
        }

    </tbody>

</table>

<a asp-action="Index"
   class="btn btn-secondary">
    Volver
</a>