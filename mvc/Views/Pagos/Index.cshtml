@model IEnumerable<mvc.Models.Pago>

<h1>Pagos de la reserva @ViewBag.ReservaId</h1>

<div class="mb-3">
  <div><strong>Inquilino:</strong> @ViewBag.NombreInquilino</div>
  <div><strong>Inmueble:</strong> @ViewBag.DireccionInmueble</div>
  <div><strong>Desde:</strong> @(((DateTime)ViewBag.FechaDesde).ToShortDateString())</div>
  <div><strong>Hasta:</strong> @(((DateTime)ViewBag.FechaHasta).ToShortDateString())</div>
  <div><strong>Estado:</strong> @ViewBag.EstadoReserva</div>
</div>

@if (TempData["Ok"] != null)
{
  <div class="alert alert-success">@TempData["Ok"]</div>
}

@if (TempData["Error"] != null)
{
  <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (ViewBag.PuedeCargarPago)
{
  <a asp-action="Crear" asp-route-reservaId="@ViewBag.ReservaId" class="btn btn-primary mb-3">
    Nuevo pago
  </a>
}

@if (!Model.Any())
{
  <p>No hay pagos cargados para esta reserva.</p>
}
else
{
  <table class="table">
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Concepto</th>
        <th>Importe</th>
        <th>Metodo</th>
        <th>Estado</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var pago in Model)
      {
        <tr class="@(pago.Estado == EstadoPago.Anulado ? "table-secondary" : "")">
          <td>@pago.Fecha.ToShortDateString()</td>
          <td>@pago.Concepto</td>
          <td>@pago.Importe.ToString("C")</td>
          <td>@pago.Metodo</td>
          <td>@pago.Estado</td>
          <td>
            <a asp-action="Detalles" asp-route-id="@pago.Id" class="btn btn-info btn-sm">Detalles</a>

            @if (pago.Estado != EstadoPago.Anulado)
            {
              <a asp-action="EditarConcepto" asp-route-id="@pago.Id" class="btn btn-primary btn-sm">Editar concepto</a>

              <form asp-action="Anular" asp-route-id="@pago.Id" asp-route-reservaId="@pago.ReservaId" method="post"
                    style="display:inline">
                <button type="submit" class="btn btn-danger btn-sm"
                        onclick="return confirm('Anular este pago?')">Anular</button>
              </form>
            }
          </td>
        </tr>

        @if (User.IsInRole("Administrador") && (!string.IsNullOrEmpty(pago.NombreUsuarioCreador) ||
      !string.IsNullOrEmpty(pago.NombreUsuarioAnulador)))
        {
          <tr class="@(pago.Estado == EstadoPago.Anulado ? "table-secondary" : "")">
            <td colspan="6" class="text-muted small">
              @if (!string.IsNullOrEmpty(pago.NombreUsuarioCreador))
              {
                <span>Creado por: @pago.NombreUsuarioCreador</span>
              }
              @if (!string.IsNullOrEmpty(pago.NombreUsuarioAnulador))
              {
                <span class="ms-3">Anulado por: @pago.NombreUsuarioAnulador</span>
              }
            </td>
          </tr>
        }
      }
    </tbody>
  </table>
}

<a asp-controller="Reserva" asp-action="Detalles" asp-route-id="@ViewBag.ReservaId" class="btn btn-secondary">Volver</a>
