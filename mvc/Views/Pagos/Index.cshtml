@model IEnumerable<mvc.Models.Pago>

@{
  int paginaActual = ViewBag.PaginaActual ?? 1;
  int totalPaginas = ViewBag.TotalPaginas ?? 0;
  string conceptoFiltro = ViewBag.ConceptoFiltro ?? "";
  EstadoPago? estadoFiltro = ViewBag.EstadoFiltro as EstadoPago?;
}

<h1>Pagos de la reserva @ViewBag.ReservaId</h1>

<div class="mb-3">
  <div><strong>Inquilino:</strong> @ViewBag.NombreInquilino</div>
  <div><strong>Inmueble:</strong> @ViewBag.DireccionInmueble</div>
  <div><strong>Desde:</strong> @(((DateTime)ViewBag.FechaDesde).ToShortDateString())</div>
  <div><strong>Hasta:</strong> @(((DateTime)ViewBag.FechaHasta).ToShortDateString())</div>
  <div><strong>Estado:</strong> @ViewBag.EstadoReserva</div>
</div>

@if (TempData["Ok"] != null)
{
  <div class="alert alert-success">@TempData["Ok"]</div>
}

@if (TempData["Error"] != null)
{
  <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
  <input type="hidden" name="idReserva" value="@ViewBag.ReservaId" />

  <div class="col-md-4">
    <label class="form-label" for="concepto">Concepto</label>
    <input id="concepto" name="concepto" class="form-control" value="@conceptoFiltro" />
  </div>

  <div class="col-md-3">
    <label class="form-label" for="estado">Estado</label>
    <select id="estado" name="estado" class="form-select">
      <option value="">Todos</option>
      @foreach (EstadoPago valor in Enum.GetValues(typeof(EstadoPago)))
      {
        if (estadoFiltro == valor)
        {
          <option value="@valor" selected>@valor</option>
        }
        else
        {
          <option value="@valor">@valor</option>
        }
      }
    </select>
  </div>

  <div class="col-md-5">
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
    <a asp-action="Index" asp-route-idReserva="@ViewBag.ReservaId" class="btn btn-outline-secondary">Limpiar</a>
  </div>
</form>

@if (ViewBag.PuedeCargarPago)
{
  <a asp-action="Crear" asp-route-reservaId="@ViewBag.ReservaId" class="btn btn-primary mb-3">
    Nuevo pago
  </a>
}

@if (!Model.Any())
{
  <p>No hay pagos cargados para esta reserva.</p>
}
else
{
  <table class="table">
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Concepto</th>
        <th>Importe</th>
        <th>Metodo</th>
        <th>Estado</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var pago in Model)
      {
        <tr class="@(pago.Estado == EstadoPago.Anulado ? "table-secondary" : "")">
          <td>@pago.Fecha.ToShortDateString()</td>
          <td>@pago.Concepto</td>
          <td>@pago.Importe.ToString("C")</td>
          <td>@pago.Metodo</td>
          <td>@pago.Estado</td>
          <td>
            <a asp-action="Detalles" asp-route-id="@pago.Id" class="btn btn-info btn-sm">Detalles</a>

            @if (pago.Estado != EstadoPago.Anulado)
            {
              <a asp-action="EditarConcepto" asp-route-id="@pago.Id" class="btn btn-primary btn-sm">Editar concepto</a>

              @if (User.IsInRole("Administrador"))
              {
                <form asp-action="Anular" asp-route-id="@pago.Id" asp-route-reservaId="@pago.ReservaId" method="post"
                      style="display:inline">
                  <button type="submit" class="btn btn-danger btn-sm"
                          onclick="return confirm('Anular este pago?')">Anular</button>
                </form>
              }
            }
          </td>
        </tr>
      }
    </tbody>
  </table>
}

@{
  int ventana = 2;
  int desde = Math.Max(1, paginaActual - ventana);
  int hasta = Math.Min(totalPaginas, paginaActual + ventana);
}

@if (totalPaginas > 1)
{
  <nav class="mt-3">
    <ul class="pagination">
      <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
        <a class="page-link" asp-action="Index"
           asp-route-idReserva="@ViewBag.ReservaId"
           asp-route-concepto="@conceptoFiltro"
           asp-route-estado="@estadoFiltro"
           asp-route-pagina="@(paginaActual - 1)">Anterior</a>
      </li>

      @if (desde > 1)
      {
        <li class="page-item">
          <a class="page-link" asp-action="Index"
             asp-route-idReserva="@ViewBag.ReservaId"
             asp-route-concepto="@conceptoFiltro"
             asp-route-estado="@estadoFiltro"
             asp-route-pagina="1">1</a>
        </li>
        if (desde > 2)
        {
          <li class="page-item disabled"><span class="page-link">...</span></li>
        }
      }

      @for (int i = desde; i <= hasta; i++)
      {
        <li class="page-item @(i == paginaActual ? "active" : "")">
          <a class="page-link" asp-action="Index"
             asp-route-idReserva="@ViewBag.ReservaId"
             asp-route-concepto="@conceptoFiltro"
             asp-route-estado="@estadoFiltro"
             asp-route-pagina="@i">@i</a>
        </li>
      }

      @if (hasta < totalPaginas)
      {
        if (hasta < totalPaginas - 1)
        {
          <li class="page-item disabled"><span class="page-link">...</span></li>
        }
        <li class="page-item">
          <a class="page-link" asp-action="Index"
             asp-route-idReserva="@ViewBag.ReservaId"
             asp-route-concepto="@conceptoFiltro"
             asp-route-estado="@estadoFiltro"
             asp-route-pagina="@totalPaginas">@totalPaginas</a>
        </li>
      }

      <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
        <a class="page-link" asp-action="Index"
           asp-route-idReserva="@ViewBag.ReservaId"
           asp-route-concepto="@conceptoFiltro"
           asp-route-estado="@estadoFiltro"
           asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
      </li>
    </ul>
  </nav>
}

<a asp-controller="Reserva" asp-action="Detalles" asp-route-id="@ViewBag.ReservaId" class="btn btn-secondary">Volver</a>
