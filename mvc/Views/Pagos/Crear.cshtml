@model mvc.Models.Pago

<h1>Nuevo pago</h1>

<form asp-action="Crear" method="post">
    <input type="hidden" asp-for="ReservaId" />

    <div class="mb-3">
        <label asp-for="Fecha" class="form-label">Fecha</label>
        <input asp-for="Fecha" class="form-control" type="date" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Concepto" class="form-label">Concepto</label>
        <input asp-for="Concepto" class="form-control" />
        <span asp-validation-for="Concepto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Importe" class="form-label">Importe</label>
        <input asp-for="Importe" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Importe" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Metodo" class="form-label">Método</label>
        <select asp-for="Metodo" class="form-select" asp-items="Html.GetEnumSelectList<MetodoPago>()"></select>
        <span asp-validation-for="Metodo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<EstadoPago>()"></select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ComprobanteUrl" class="form-label">URL del comprobante</label>
        <input asp-for="ComprobanteUrl" class="form-control" />
        <span asp-validation-for="ComprobanteUrl" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" asp-route-idReserva="@Model.ReservaId" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
