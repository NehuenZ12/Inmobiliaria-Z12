<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Inmobiliaria</title>

  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/mvc.styles.css" asp-append-version="true" />
</head>

<body>

  <header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

      <div class="container-fluid">

        <a class="navbar-brand" asp-controller="Propietario" asp-action="Index">
          Inmobiliaria
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Mostrar navegación">

          <span class="navbar-toggler-icon"></span>

        </button>

        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

          <ul class="navbar-nav">

            <li class="nav-item">
              <a class="nav-link text-dark" asp-controller="Propietario" asp-action="Index">
                Propietarios
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link text-dark" asp-controller="Inmueble" asp-action="Index">
                Inmuebles
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link text-dark" asp-controller="Inquilino" asp-action="Index">
                Inquilinos
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link text-dark" asp-controller="Reserva" asp-action="Index">
                Reservas
              </a>
            </li>

            @if (User.IsInRole("Administrador"))
            {
              <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Usuarios" asp-action="Index">
                  Usuarios
                </a>
              </li>
            }

          </ul>

          <ul class="navbar-nav">
            @if (User.Identity?.IsAuthenticated == true)
            {
              <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Usuarios" asp-action="Perfil">
                  @User.Identity.Name
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Usuarios" asp-action="Logout">
                  Salir
                </a>
              </li>
            }
            else
            {
              <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Usuarios" asp-action="Login">
                  Ingresar
                </a>
              </li>
            }
          </ul>

        </div>

      </div>

    </nav>
  </header>


  <div class="container">

    <main role="main" class="pb-3">
      @RenderBody()
    </main>

  </div>


  <footer class="border-top footer text-muted">

    <div class="container">
      &copy; 2026 - Inmobiliaria
    </div>

  </footer>


  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>

  @await RenderSectionAsync("Scripts", required: false)

</body>

</html>